
name "ppl7"
platforms "windows"

buildType "debug" {
	buildOptions "debugMode" "debugInfo" "alwaysStackFrame" "stackStomping" "warningsAsErrors"
}
buildType "release" {
	buildOptions "releaseMode" "optimize" "inline" "noBoundsCheck"
}

configuration "test" {
	targetType "executable"
	targetName "ppl7"
	excludedSourceFiles "src/lsp.d"
}
configuration "library" {
	targetType "library"
	excludedSourceFiles "src/test.d" "src/lsp.d"
}

# Headers and libs directly from the llvm git repo
dflags "-P=-IC:/Temp/llvm-project/llvm/include/"
dflags "-P=-IC:/Temp/llvm-project/llvm/build/include/"
lflags "/LIBPATH:C:/Temp/llvm-project/llvm/build/Release/lib"
#lflags "/LIBPATH:C:/Temp/llvm-project/llvm/build/Debug/lib"

# llvm 23 libs (from llvm-config --libnames all)
libs "LLVMABI" "LLVMAggressiveInstCombine" "LLVMAnalysis" "LLVMAsmParser" "LLVMAsmPrinter"
libs "LLVMBinaryFormat" "LLVMBitReader" "LLVMBitWriter" "LLVMBitstreamReader" "LLVMCAS"
libs "LLVMCFGuard" "LLVMCGData" "LLVMCodeGen" "LLVMCodeGenTypes" "LLVMCore"
libs "LLVMCoroutines" "LLVMCoverage" "LLVMDTLTO" "LLVMDWARFCFIChecker" "LLVMDWARFLinker"
libs "LLVMDWARFLinkerClassic" "LLVMDWARFLinkerParallel" "LLVMDWP" "LLVMDebugInfoBTF" "LLVMDebugInfoCodeView"
libs "LLVMDebugInfoDWARF" "LLVMDebugInfoDWARFLowLevel" "LLVMDebugInfoGSYM" "LLVMDebugInfoLogicalView" "LLVMDebugInfoMSF"
libs "LLVMDebugInfoPDB" "LLVMDemangle" "LLVMDlltoolDriver" "LLVMExecutionEngine" "LLVMExtensions"
libs "LLVMFileCheck" "LLVMFrontendAtomic" "LLVMFrontendDirective" "LLVMFrontendDriver" "LLVMFrontendHLSL"
libs "LLVMFrontendOffloading" "LLVMFrontendOpenACC" "LLVMFrontendOpenMP" "LLVMFuzzMutate" "LLVMFuzzerCLI"
libs "LLVMGlobalISel" "LLVMHipStdPar" "LLVMIRPrinter" "LLVMIRReader" "LLVMInstCombine"
libs "LLVMInstrumentation" "LLVMInterfaceStub" "LLVMInterpreter" "LLVMJITLink" "LLVMLTO"
libs "LLVMLibDriver" "LLVMLineEditor" "LLVMLinker" "LLVMMC" "LLVMMCA"
libs "LLVMMCDisassembler" "LLVMMCJIT" "LLVMMCParser" "LLVMMIRParser" "LLVMObjCARCOpts"
libs "LLVMObjCopy" "LLVMObject" "LLVMObjectYAML" "LLVMOption" "LLVMOrcDebugging"
libs "LLVMOrcJIT" "LLVMOrcShared" "LLVMOrcTargetProcess" "LLVMPasses" "LLVMPlugins"
libs "LLVMProfileData" "LLVMRemarks" "LLVMRuntimeDyld" "LLVMSandboxIR" "LLVMScalarOpts"
libs "LLVMSelectionDAG" "LLVMSupport" "LLVMSupportLSP" "LLVMSymbolize" "LLVMTableGen"
libs "LLVMTarget" "LLVMTargetParser" "LLVMTelemetry" "LLVMTextAPI" "LLVMTextAPIBinaryReader"
libs "LLVMTransformUtils" "LLVMVectorize" "LLVMWindowsDriver" "LLVMWindowsManifest" "LLVMX86AsmParser"
libs "LLVMX86CodeGen" "LLVMX86Desc" "LLVMX86Disassembler" "LLVMX86Info" "LLVMX86TargetMCA"
libs "LLVMXRay" "LLVMipo"

# Required for RtlGetLastNtStatus in lib/Support/ErrorHandling.cpp.
libs "ntdll"
