/**
 * magic!!
 * name "test builtins"
 * tags [builtin, pete]
 * args []
 */

#  @isConst(Expression)

#  @isUnion(Expression)     *todo - not yet implemented
#  @initOf(Expression)      *todo - not yet implemented
public fn main() {
    int a = 1
    byte b = 2 as byte
    bool c = true
    float d = 3.14
    double e = 3.14159
    long f = 1234567890
    long g = 1234567890
    short h = 123 as short
    int* i = null
    struct { int a, int b } s
    int[2] j

    assert @isInteger(a)
    assert @isInteger(b)
    assert @isBool(c)
    assert @isBool(false)
    assert @isReal(d)
    assert @isReal(e)
    assert @isInteger(f)
    assert @isInteger(g)
    assert @isInteger(h)
    assert @isPointer(i)
    assert @isValue(a)
    assert @isStruct(s)
    assert @isStruct(BI_1)
    assert @isStruct(BI_2)
    assert @isPacked(BI_1) is false
    assert @isPacked(BI_2)
    assert @isArray(j)
    assert @isArray([1,2,3])
    assert @isArray([])

    # @sizeOf
    assert @sizeOf(int) is 4
    assert @sizeOf(byte) is 1
    assert @sizeOf(bool) is 1
    assert @sizeOf(float) is 4
    assert @sizeOf(double) is 8
    assert @sizeOf(long) is 8
    assert @sizeOf(a) is 4

    # @isFunction
    fn()->void fptr
    int notf

    assert @isFunction(main)
    assert @isFunction(fptr)
    assert @isFunction(int) is false
    assert @isFunction(notf) is false

    # @isVoid
    assert @isVoid(void)
    assert @isVoid(int) is false
    assert @isVoid(notf) is false

    # @isEnum
    TB_1 en
    assert @isEnum(TB_1)
    assert @isEnum(en)
    assert @isEnum(int) is false
    assert @isEnum(notf) is false

    # @isPublic
    assert @isPublic(a) is false
    assert @isPublic(main)
    assert @isPublic(g_public)
    assert @isPublic(g_private) is false
    assert @isPublic(TB_1) is false
    assert @isPublic(BI_3)
    assert @isPublic(int) is false

    # @alignOf
    assert @alignOf(int) is 4
    assert @alignOf(byte) is 1
    assert @alignOf(bool) is 1
    assert @alignOf(float) is 4
    assert @alignOf(double) is 8
    assert @alignOf(long) is 8
    assert @alignOf(a) is 4

    # @offsetOf
    assert @offsetOf(s.a) is 0
    assert @offsetOf(s.b) is 4

    #error "@offsetOf not a struct member" requires a struct member as the first argument
    Frank f
    int b = @offsetOf(f)
    #end

    #error "@offsetOf not a struct member" requires a struct member as the first argument
    int b = @offsetOf(Frank)
    #end

    # @isConst
    const int cint = 1
    const float cfloat = 1.0
    assert @isConst(cint)
    assert @isConst(cfloat)
    assert @isConst(a) is false
    assert @isConst(j) is false

    # @typeOf
    assert @typeOf(a) is int
    assert @typeOf(b) is byte
    assert @typeOf(c) is bool
    assert @typeOf(d) is float
    assert @typeOf(e) is double
    assert @typeOf(f) is long
    assert @typeOf(g) is long
    assert @typeOf(h) is short
    assert @typeOf(i) is int*
    assert @typeOf(s) is struct { int a, int b }
    assert @typeOf(j) is int[2]

    shl()
    shr()
}

fn shl() {
    int a = 1
    int b = @shl(a, 1)          ; assert b is 0b10
    int c = @shl(b, 1)          ; assert c is 0b100
    int d = @shl(c, 2)          ; assert d is 0b10000
    byte e = @shl(3, 2) as byte ; assert e is 12                ; assert e is @shl(3,2)
    int f = 0xff                ; assert @shl(f, 1) is 0x1fe
}
fn shr() {
    int a = 0xffffffff
    int b = @shr(a, 1)  ; assert b is 0xffffffff
    int c = @shr(1, 1)  ; assert c is 0
    int d = @shr(7, c)  ; assert d is 7
    assert @ushr(3, 1) is 1
    assert @shr(1, 1) is 0
}

enum TB_1 {
    A
    B
}

struct BI_1 {
    int a
    bool b
}

[[packed]]
struct BI_2 {
    int a
    bool b
}

struct Frank {
    int a
}

public struct BI_3 {
    int a
}

int g_private
public int g_public
