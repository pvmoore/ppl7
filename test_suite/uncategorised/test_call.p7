/**
 * magic!!
 * name "test call"
 * tags [call]
 * args []
 */

# qual_f1
# qual_f2
# qual_f3 (private)
import tc2 = imports/qualified

# unqual_f1
# unqual_f2
# unqual_f3 (private)
import       imports/unqualified

/**
 * Test calling Functions in qualified and unqualified form.
 */
public fn main() {
    callLocal()
    callQualified()
    callUnqualified()
}

fn callLocal() {
    local()
    local(3)
    local(3.1)
}

fn callQualified() {
    #---------------------------------------- Call functions
    assert tc2.qual_f1() is 1
    assert tc2.qual_f2('a') is 2

    #---------------------------------------- Call function ptrs
    assert tc2.qual_v1() is 1
    assert tc2.qual_v2('b') is 2

    #error "imported qualified function is private" Function not found: qual_f3
    tc2.qual_f3()
    #end
}

fn callUnqualified() {
    #error - "imported qualified function must be qualified" Function not found: qual_f1
    qual_f1()
    #end

    #error - "imported qualified function must be qualified" Function not found: qual_f2
    qual_f2('z')
    #end

    # Call functions
    assert unqual_f1() is 3
    assert unqual_f2('c') is 4

    # Call function ptrs
    assert unqual_v1() is 3
    assert unqual_v2('d') is 4

    #error "imported unqualified function is private" Function not found: unqual_f3
    unqual_f3()
    #end
}

fn local() {

}
fn local(int a) {
    assert a is 3
}
fn local(float a) {
    assert a is 3.1
}
