/**
 * magic!!
 * name "test if"
 * tags [if]
 * args []
 */
public fn main() {
    ifStatement()
    ifExpression()
}

fn ifStatement() {
    # if with then
    int a = 1
    if(a is 1) {
        a = 2
    }
    assert a is 2

    # if with then and else branch
    int a2 = 1
    if(a2 is 1) {
        a2 = 2
    } else {
        a2 = 3
    }
    assert a2 is 2

    if(a2 is 1) {
        a2 = 2
    } else {
        a2 = 3
    }
    assert a2 is 3

    # if with then and else branch without braces
    int a3 = 1
    if(a3 is 1) a3 = 2 else a3 = 3
    assert a3 is 2

    if(a3 is 1) a3 = 2 else a3 = 3
    assert a3 is 3
}
fn ifExpression() {
    int a = if(true) 3 else 4
    assert a is 3

    int b = if(false) 3 else 4
    assert b is 4

    int c = if(false) {
        int d = 3
        d + 10
    } else {
        int e = 4
        e + 20
    }
    assert c is 24
}
