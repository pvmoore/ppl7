/**
 * magic!!
 * name "test is"
 * tags [is]
 * args []
 */
public fn main() {
    int a  = 1
    byte b = 2 as byte

    int* bb;      assert bb is null

    #error "double negation" Boolean 'not' should be replaced with 'is false'
    assert bb is not not null
    #end

    # Type is Type
    bool c = int is int     ; assert c
    bool d = int is not int ; assert d is false
    assert int is int
    assert int is not bool

    #error "Type is Expression" Use @typeOf here instead
    bool nope = int is a
    #end

    #error "Expression is Type" Use @typeOf here instead
    bool nope = a is int
    #end

    bool e1 = int is @typeOf(a)      ; assert e1
    bool e2 = @typeOf(a) is int      ; assert e2
    bool e3 = @typeOf(a) is not byte ; assert e3

    # Pointer is pointer
    int* f1  = null
    int* f2  = &a
    byte* f3 = &b
    int* f4  = &a
    assert f1 is not f2
    assert f2 is not f3
    assert f4 is f2

    #error "pointer is value" Pointer is value is always false
    assert f1 is not a
    #end

    # Expression is Expression
    assert a is a       # int is int
    assert a is 1       # int is int
    assert 1 is a       # int is int
    assert 1 is not 2   # int is not int
    assert b is 2       # byte is int
    assert a is not b   # int is not byte

    #error "Ambiguous 'is' expressions" Use parentheses to clarify the intended meaning
    bool nope = 1 is 1 is not true
    #end

    # ok
    bool nope = (1 is 1) is not true

    #error "Ambiguous 'is' expressions" Use parentheses to clarify the intended meaning
    bool nope = 1 is 1 is false
    #end

    arrayComparison()
    structValueComparison()
}

# Array is Array
fn arrayComparison() {
    int[2] a1 = [1, 2]
    int[2] a2 = [1, 2]
    int[2] a3 = [3, 4]

    int[3] b1 = [1, 2, 3]

    assert a1 is a2
    assert a2 is not a3
    assert a2 is not b1

    assert a1 is [1,2]
    assert a1 is not [2,1]

    #error "wrong number of elements" Array literal has 1 elements, but the array type requires 2
    assert a1 is not [1]
    #end

    int a = 3

    #error "int array is not an int" \(int\[2\] is not int\) No common type
    assert a1 is not a
    #end

    #error "int is not an int array" \(int is not int\[2\]\) No common type
    assert a is not a1
    #end
}
# struct is struct
fn structValueComparison() {
    Outer outer

    assert outer is { a:0, b:0, c:null, inner: { x:0, y:0, z:[0,0] } }

    int a
    int* p = &a

    assert outer is not { a:1, b:0, c:null, inner: { x:0, y:0, z:[0,0] } }
    assert outer is not { a:0, b:1, c:null, inner: { x:0, y:0, z:[0,0] } }
    assert outer is not { a:0, b:0, c:p,    inner: { x:0, y:0, z:[0,0] } }
    assert outer is not { a:0, b:0, c:null, inner: { x:1, y:0, z:[0,0] } }
    assert outer is not { a:0, b:0, c:null, inner: { x:0, y:1, z:[0,0] } }
    assert outer is not { a:0, b:0, c:null, inner: { x:0, y:0, z:[1,0] } }
    assert outer is not { a:0, b:0, c:null, inner: { x:0, y:0, z:[0,1] } }

    Monkey monkey
    assert monkey is { a: [0,0,0] }
    assert monkey is not { a: [1,0,0] }
    assert monkey is not { a: [0,1,0] }
    assert monkey is not { a: [0,0,1] }

    Empty empty
    assert empty is {}

    ContainsEmpty containsEmpty
    assert containsEmpty is { a: 5, b: {} }
}

struct Empty {

}
struct ContainsEmpty {
    int a = 5
    Empty b
}
struct Outer {
    int a
    float b
    int* c
    Inner inner
}
struct Inner {
    int x
    int y
    int[2] z
}
struct Monkey {
    int[3] a
}
