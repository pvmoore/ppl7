/**
 * magic!!
 * name "test unsigned"
 * tags [unsigned]
 * args []
 */

public fn main() {
    int a = 8           ; assert @sizeOf(a) is 4
    int b = 0xffffffff  ; assert b is -1              ; assert @sizeOf(b) is 4
    bool c              ; assert @sizeOf(c) is 1

    # >>, >>>
    assert a >> 1 is 4
    assert a >>> 1 is 4
    assert a << 1 is 16

    assert b >> 1 is 0xffffffff
    assert b >>> 1 is 0x7fffffff

    # >>=, >>>=
    a >>= 1; assert a is 4
    a <<= 1; assert a is 8
    b >>= 1; assert b is 0xffffffff
    b <<= 1; assert b is 0xfffffffe

    b = 0xffffffff
    b >>>= 1; assert b is 0x7fffffff

    # /, //
    int d = 0xffffffff
    int e = -1
    assert d // 2 is 0x7fffffff
    assert e / 2 is 0

    # /=, //=
    d //= 2
    e /= 2
    assert d is 0x7fffffff
    assert e is 0

    # %, %%
    d = 0xffffffff
    e = -1
    assert d %% 2 is 1
    assert e % 2 is -1

    # %=, %%=
    d %%= 2
    e %= 2
    assert d is 1
    assert e is -1

    # <, |<|
    assert 1 < 10
    assert -10 < 1
    assert 1 |<| 10
    assert -10 |<| 1 is false

    # >, |>|
    assert 10 > 1
    assert 1 > -10
    assert 10 |>| 1
    assert 1 |>| -10 is false

    # <=, |<=|
    assert 1 <= 10
    assert -10 <= 1
    assert 1 |<=| 10
    assert -10 |<=| 1 is false

    # >=, |>=|
    assert 10 >= 1
    assert 1 >= -10
    assert 10 |>=| 1
    assert 1 |>=| -10 is false

    # unsigned vs real is not allowed
    #assert 1.0 |<| 10.0
}
