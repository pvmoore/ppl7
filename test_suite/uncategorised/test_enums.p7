/**
 * magic!!
 * name "test enums"
 * tags [enum]
 * args []
 */

/**
 * Enums:
 *   - QualEnum
 */
import te2 = imports/qualified

/**
 * Enums:
 *   - UnqualEnum
 */
import imports/unqualified

public fn main() {
    defaultInit()
    test_qualified()
    test_unqualified()
    test_casting()

    int a = LocalEnum.A as int
    assert a is 0
    assert @typeOf(LocalEnum.A) is LocalEnum
    assert @typeOf(LocalEnum) is LocalEnum
    assert @typeOf(LocalEnum.A) is not int
    assert LocalEnum.B is 1 as LocalEnum
    assert LocalEnum.C is 2 as LocalEnum
    #assert TE1.D is 0    # error - identifier not found

    assert @typeOf(ByteEnum.A) is ByteEnum
    assert ByteEnum.A is 0 as ByteEnum
    assert ByteEnum.B is 10 as ByteEnum
    assert ByteEnum.C is 11 as ByteEnum
    assert ByteEnum.D is 7 as ByteEnum
    assert ByteEnum.E is 8 as ByteEnum

    IntStructEnum te1c       # default init to IntStructEnum.A
    assert te1c.a is 1

    # Global enum is default initialised in the init function
    assert g_te1c.a is 1

    assert IntPtrStructEnum.A is null
}

#--------------------------------------------------------------------------------------------

fn defaultInit() {
    LocalEnum a           # default init to TE1.A
    assert a is LocalEnum.A
    assert a is 0 as LocalEnum

    LocalEnum2 b
    assert b is LocalEnum2.A

    #error "enum is not an int" \(LocalEnum2 is int\) No common type
    assert b is 3
    #end
    assert b as int is 3

    ByteEnum c
    assert c is ByteEnum.A
    assert c as byte is 0

    IntStructEnum ddd
    assert ddd is IntStructEnum.A

    assert ddd as IntStruct is { a:1 }
}

fn test_qualified() {
    int a = te2.QualEnum.A as int
    assert a is 0   ; assert @typeOf(te2.QualEnum.A) is te2.QualEnum
    assert te2.QualEnum.B is 1 as te2.QualEnum
    assert te2.QualEnum.C is 2 as te2.QualEnum

    #error "enum is not public" 'QualEnum2' cannot be resolved to a variable or function
    te2.QualEnum2 a
    #end
}

fn test_unqualified() {
    int a = UnqualEnum.A as int
    assert a is 0
    assert @typeOf(UnqualEnum.A) is UnqualEnum
    assert UnqualEnum.B is 1 as UnqualEnum
    assert UnqualEnum.C is 2 as UnqualEnum

    #error "enum is not public" 'UnqualEnum2' cannot be resolved to a variable or function
    UnqualEnum2 a
    #end
}

fn test_casting() {
    float a = LocalEnum.B as float
    assert a is 1.0

    LocalEnum e = 1 as LocalEnum
    assert e is LocalEnum.B
}

#--------------------------------------------------------------------------------------------

# globals
IntStructEnum g_te1c

#types
enum LocalEnum {  # int
    A       # 0
    B       # 1
    C       # 2
}
enum LocalEnum2 {
    A = 3
    B       # 4
}
enum ByteEnum : byte {  # byte
    A               # 0
    B = 10 as byte  # 10
    C               # 11
    D = 7 as byte   # 7
    E               # 8
}
struct IntStruct {
    int a
}
enum IntStructEnum : IntStruct {
    A = { a:1 }
    B = { a:2 }
}

enum IntPtrStructEnum : int* {
    A = null
}

#error "empty enum" Enums must have at least one member
enum EmptyEnum {}
#end

#error "null enum initialiser" Cannot implicitly convert null to BadEnum1
enum BadEnum1 {
    A = 1
    B = null    # cannot convert null to BadEnum1
}
#end

#error "float enum initialiser" Enum member cannot be implicitly converted to int
enum BadEnum2 {
    A
    B = 1.1
}
#end
