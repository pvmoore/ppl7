/**
 * magic!!
 * name "test anonymous structs"
 * tags [struct,anon-struct]
 * args []
 */
public fn main() {
    #---------------------------- Anon struct with default initialisation
    struct {
        int a
        float b
        bool c
    } anonStruct

    assert anonStruct is { 0, 0.0, false }

    assert @isStruct(anonStruct)
    assert @typeOf(anonStruct) is struct { int; float; bool; }
    assert @typeOf(anonStruct) is struct { int a; float b; bool c; }
    assert @typeOf(anonStruct) is struct { int float bool }

    assert @typeOf(anonStruct) is not int

    assert @sizeOf(anonStruct) is 12
    assert @alignOf(anonStruct) is 4
    assert @offsetOf(anonStruct.a) is 0
    assert @offsetOf(anonStruct.b) is 4
    assert @offsetOf(anonStruct.c) is 8
    assert @isValue(anonStruct)
    assert @isPointer(anonStruct) is false
    assert @isInteger(anonStruct) is false
    assert @isReal(anonStruct) is false
    assert @isBool(anonStruct) is false

    anonStruct.a = 1
    anonStruct.b = 2.0
    anonStruct.c = true

    assert anonStruct is { 1, 2.0, true }
    assert anonStruct.a is 1
    assert anonStruct.b is 2.0
    assert anonStruct.c is true

    #error "unnamed struct member" Struct member missing name
    struct {
        int
    } nope
    #end

    struct { int a float b = 3.14 bool c } anonStruct2

    assert anonStruct2 is { 0, 3.14, false }
    assert anonStruct2.a is 0
    assert anonStruct2.b is 3.14
    assert anonStruct2.c is false

    #---------------------------- Anon struct with initialiser
    struct { int a; float b; bool c; } anonStruct3 = { 1, 2.0, true }

    assert anonStruct3 is { 1, 2.0, true }
    assert anonStruct3.a is 1
    assert anonStruct3.b is 2.0
    assert anonStruct3.c is true

    anonStructCall()
    anonStructCasting()
}

fn anonStructCall() {
    struct { int a; float b; bool c; } intFloatBool
    struct { int a; int b; bool c; } intIntBool

    # ok - exact match identifier
    anons1(intFloatBool)

    # ok - exact match struct literal
    anons1({ 1, 2.0, true })

    #error "arg type mismatch" Cannot implicitly convert float to the struct member type int
    anons1({ 1.0, 2.0, true })
    #end
}

fn anons1(struct { int a; float b; bool c; } s) {

}

fn anonStructCasting() {
    struct { int a; int b; bool c; } s1 = { 1, 2, true }

    # Ok. Structs are the same Type
    struct{int a,int b,bool c} s2 = s1

    #error "invalid cast" Cannot cast struct\{int, int, bool\} to struct\{int, float, bool\}
    struct { int a; float b; bool c; } nope = s1 as struct { int a; float b; bool c; }
    #end
}
