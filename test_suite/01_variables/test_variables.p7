/**
 * magic!!
 * name "test variables"
 * tags [variable]
 * args []
 */

import console = core:console

public fn main() {
    locals()
    globals()

    #error "variable not found" cannot be resolved
    a = 0
    #end
}

fn locals() {
    bool a          ; assert a is false ; assert @typeOf(a) is bool
    byte b          ; assert b is 0     ; assert @typeOf(b) is byte
    short c         ; assert c is 0     ; assert @typeOf(c) is short
    int d = 2       ; assert d is 2     ; assert @typeOf(d) is int
    long e = 3      ; assert e is 3     ; assert @typeOf(e) is long
    float f         ; assert f is 0.0   ; assert @typeOf(f) is float
    double g = 5.0  ; assert g is 5.0   ; assert @typeOf(g) is double

    int* h;         assert h is null;  assert @typeOf(h) is int*

    fn()->void f1;  assert f1 is null; assert @typeOf(f1) is fn()->void

    #error "variable initialiser type mismatch" Cannot implicitly convert float to int
    int b2 = 2.1
    #end

    #error "shadowing local" shadows another variable in the same scope
    int a = 3
    #end
}

fn globals() {
    assert tv_g_a is false
    assert tv_g_b is 1
    assert tvFuncPtr is null

    #error "shadowing global" shadows another variable in the same scope
    int tv_g_a = 3
    #end
}

#--------------------------------------------------------------------------------------------
# Global variables
#--------------------------------------------------------------------------------------------

bool tv_g_a
int tv_g_b = 1

#error "const not initialised" Const variables must be initialised
const int g_z
#end

const int g_a = 7

#error "shadowing global" shadows another variable in the same scope
int tv_g_a = 2
#end

# Global variable function ptr
fn()->void tvFuncPtr


