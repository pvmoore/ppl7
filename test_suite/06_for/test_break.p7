/**
 * magic!!
 * name "break"
 * tags [for,break]
 * args []
 */
public fn main() {
    simpleBreakForwardSequence()
    simpleBreakReverseSequence()
    breakInInnerLoop()
    breakInOuterLoop()
    breakOutOf2Loops()
    errors()
}

fn simpleBreakForwardSequence() {
    int count4before
    int count4after
    int value4
    for i, 0..<4 {
        count4before += 1
        value4 = i
        if(i is 1) break
        count4after += 1
    }
    assert count4before is 2
    assert count4after is 1
    assert value4 is 1
}
fn simpleBreakReverseSequence() {
    int count3before
    int count3after
    int value3
    for i, 4>..0 {
        # 3,2,1,0
        count3before += 1
        value3 = i
        if(i is 2) break
        count3after += 1
    }
    assert count3before is 2
    assert count3after is 1
    assert value3 is 2
}

fn breakInInnerLoop() {
    int before1
    int before2
    int after1
    int after2
    for int i, 0..<5 {
        # 0,1,2,3,4
        before1 += 1
        for int j, 0..<5 {
            # 0,1,2,3,4
            before2 += 1

            if(j is 3) break 1

            after2 += 1
        }
        after1 += 1
    }
    assert before1 is 5
    assert before2 is 20
    assert after1 is 5
    assert after2 is 15
}

fn breakInOuterLoop() {
    int before
    int after
    int inner
    for int i, 0..<5 {
        # 0,1,2,3,4
        before += 1

        if(i is 3) break

        # 0,1,2

        for int j, 0..<5 {
            # 0,1,2,3,4
            inner += 1
        }
        after += 1
    }
    assert before is 4
    assert after is 3
    assert inner is 15
}

fn breakOutOf2Loops() {
    int before1
    int after1
    int before2
    int after2
    for i, 0..<3 {
        before1 += 1
        for j, 0..<3 {
            before2 += 1
            break 2

            # we will never get here
            after2 += 1
        }
        # we will never get here
        after1 += 1
    }
    assert before1 is 1
    assert after1 is 0
    assert before2 is 1
    assert after2 is 0
}

fn errors() {
    #error "break outside of loop" Break must be inside a for loop
    break
    #end

    #error "shadowing" Variable 'i' shadows another variable in the same scope
    for int i, 0..<2 {
        for int i, 0..<2 {}
    }
    #end

    #error "invalid break scope" Break number of scopes is greater than the number of enclosing for loops
    for int i, 0..<2 {
        break 2
    }
    #end
}
