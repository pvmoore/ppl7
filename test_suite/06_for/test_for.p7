/**
 * magic!!
 * name "for loop"
 * tags [for]
 * args []
 */
public fn main() {
    forwardSequence()
    reverseSequence()
    loopInLoop()
    whileLoop()
    errors()
}

fn forwardSequence() {

    int count1
    int value1
    for int i, 0..<2 { count1 += 1; value1 = i }
    assert count1 is 2
    assert value1 is 1

    int count2
    int value2
    for int i, 0..=2 { count2 += 1; value2 = i }
    assert count2 is 3
    assert value2 is 2

    int start = 1
    int end   = 3
    int count3
    int value3
    for i, start..<end { count3 += 1; value3 = i }
    assert count3 is 2
    assert value3 is 2
    assert start is 1
    assert end is 3

    int count6
    int start2 = 1
    int end2   = 3
    for int i, start2 ..< end2 {

        # updating start2 and end2 here does not affect the loop
        start2 = 2
        end2 = 0

        count6 += 1
    }
    assert count6 is 2
}
fn reverseSequence() {

    int start = 3
    int end   = 1

    int count1
    int value1
    for int i, 10>..0 { count1 += 1; value1 = i }
    assert count1 is 10
    assert value1 is 0

    int count2
    int value2
    for int i, 10=..1 { count2 += 1; value2 = i }
    assert count2 is 10
    assert value2 is 1

    int count3
    for int i, 0..=0 { count3 += 1 }
    assert count3 is 1
}
fn whileLoop() {
    int count1
    int count1a
    int value1
    for int i, true {
        count1 += 1
        value1 = i
        break
        count1a += 1
    }
    assert count1 is 1
    assert count1a is 0
    assert value1 is 0

    int count2
    for true {
        count2 += 1
        break
    }
    assert count2 is 1

    int count3
    for condition() {
        count3 += 1
    }
    assert count3 is 2
    assert g_conditionCount is 3
}
int g_conditionCount
fn condition() -> bool {
    g_conditionCount += 1
    return g_conditionCount < 3
}

fn loopInLoop() {
    int count1
    int count2
    for int i, 0..<5 {
        # 0,1,2,3,4
        count1 += 1
        for int j, 0..<5 {
            # 0,1,2,3,4
            count2 += 1
        }
    }
    assert count1 is 5
    assert count2 is 25
}

fn errors() {

    #error "no iterations" For loop will never run because the start and end are equal but isInclusive is false
    for int i, 0..<0 {}
    #end

    #error "shadowing" Variable 'dupe' shadows another variable in the same scope
    int dupe
    for int dupe, 0..<2 {}
    #end

    #error "start is not integer" For loop start and end must be integers
    for int i, 3.14..<4 {}
    #end

    #error "end is not integer" For loop start and end must be integers
    for int i, 0..<4.4 {}
    #end

    #error "start > end forward sequence" For loop start and end must have the same direction as the range
    for int i, 4..<0 {}
    #end

    #error "start > end reverse sequence" For loop start and end must have the same direction as the range
    for int i, 0>..4 {}
    #end

    #error "start == end exclusive" For loop will never run because the start and end are equal but isInclusive is false
    for int i, 0..<0 {}
    #end

    #error "start cast to counter" For loop start and end must be implicitly convertable to the counter type
    for byte i, 300>..(0 as byte) {}
    #end

    #error "end cast to counter" For loop start and end must be implicitly convertable to the counter type
    for byte i, (0 as byte)..<300 {}
    #end
}
