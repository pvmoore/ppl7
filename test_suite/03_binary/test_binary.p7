/**
 * magic!!
 * name "binary expressions"
 * tags [binary,expression,operator]
 * args []
 */
 public fn main() {
    # arithmetic
    add()
    sub()
    mul()
    div()
    udiv_()
    mod()
    umod_()
    bit_xor()
    bit_and()
    bit_or()
    shl()
    shr()
    ushr_()

    # assignment
    add_assign()
    sub_assign()
    mul_assign()
    div_assign()
    udiv_assign()
    mod_assign()
    umod_assign()
    bit_xor_assign()
    bit_and_assign()
    bit_or_assign()
    shl_assign()
    shr_assign()
    ushr_assign()

    # boolean
    less_than()
    less_than_equal()
    greater_than()
    greater_than_equal()
    unsigned_less_than()
    unsigned_less_than_equal()
    unsigned_greater_than()
    unsigned_greater_than_equal()
    bool_and()
    bool_or()
}

###############################################################################################
# arithmetic
###############################################################################################
fn add() {
    int a = 3
    int b = 7
    assert a + 3 is 6
    assert a + b is 10
    assert -1 + a is 2
}
fn sub() {
    int a = 10
    int b = 2
    assert a - b is 8
    assert a - -1 is 11
}
fn mul() {
    int a = 10
    int b = 7
    assert a * b is 70
    assert 5 * a is 50
    assert b * 2 is 14
}
fn div() {
    int a = 13
    int b = -13
    int c = 3
    assert a / 3 is 4
    assert b / 3 is -4
    assert 12 / c is 4
}
fn udiv_() {
    int a = 13 // 3  ; assert a is 4

    # note this needs to be cast to an int otherwise it will be a (byte)-13
    # -13            = 4294967283
    # 4294967283 / 3 = 1431655761
    int b = -13 // 3            ; assert b is 1431655761
    int M_THIRTEEN = -13
    int c = M_THIRTEEN // 3     ; assert b is 1431655761
}
fn mod() {
    int a = 13 % 3              ; assert a is 1
    int b = -13 % 3             ; assert b is -1
}
fn umod_() {
    int a = 13 %% 3             ; assert a is 1

    # 4294967283 % 3 = 0
    # 4294967283 % 7 = 5
    int b = -13 %% 3            ; assert b is 0
    int c = -13 %% 7            ; assert c is 5
}
fn bit_xor() {
    int a = 0b1111_0000
    int b = 0b0000_1111
    assert a ^ b is 0b1111_1111
    assert a ^ a is 0
}
fn bit_and() {
    int a = 0b1111_0000
    int b = 0b0000_1111
    assert a & b is 0b0000_0000
    assert a & a is a
    assert a & 0xffffffff is a
    assert a & 0b1100_0000 is 0b1100_0000
}
fn bit_or() {
    int a = 0b1111_0000
    int b = 0b0000_1111
    assert a | b is 0b1111_1111
    assert a | 0xffffffff is 0xffffffff
    assert a | 0 is a
}
fn shl() {
    int a = 1
    int b = 0x8000_0000
    assert a << 1 is 2
    assert a << 2 is 4
    assert b << 1 is 0
}
fn shr() {
    int a = 1
    int b = 0x8000_0000
    assert a >> 1 is 0
    assert b >> 1 is 0xc000_0000
    assert b >> 2 is 0xe000_0000
}
fn ushr_() {
    int a = 0xffff_ffff
    int b = 0x8000_0000
    assert a >>> 1 is 0x7fff_ffff
    assert b >>> 1 is 0x4000_0000
    assert b >>> 2 is 0x2000_0000
    assert 0 >>> 1 is 0
    assert 1 >>> 1 is 0
    assert 2 >>> 0 is 2
}

###############################################################################################
# assign
###############################################################################################
fn add_assign() {
    int a = 1
    int b = 5
    a += 1          ; assert a is 2
    b += a          ; assert b is 7
}
fn sub_assign() {
    int a = 1
    int b = 7
    a -= 2          ; assert a is -1
    b -= a          ; assert b is 8
}
fn mul_assign() {
    int a = 12
    int b = -10
    a *= 2          ; assert a is 24
    b *= 3          ; assert b is -30
    a *= a          ; assert a is 576
}
fn div_assign() {
    int a = 10
    a/= 3           ; assert a is 3

    int b = -100
    b/= 10          ; assert b is -10
}
fn udiv_assign() {
    int a = 10
    a//=3           ; assert a is 3

    int b = -100    # -100 = 0xffff_ff9c = 4,294,967,196
    b//= 10         ; assert b is 429_496_719
}
fn mod_assign() {
    int a = 10
    a%= 3           ; assert a is 1

    int b = -100
    b%= 3           ; assert b is -1
}
fn umod_assign() {
    int a = 10
    a%%= 3          ; assert a is 1

    int b = -102    # -102 = 0xffff_ff9a = 4,294,967,194
    b%%= 3          ; assert b is 1
}
fn bit_xor_assign() {
    int a = 0b1111_0000
    int b = 0b0000_1111
    a ^= b          ; assert a is 0b1111_1111
    b ^= 1          ; assert b is 0b0000_1110
}
fn bit_and_assign() {
    int a = 0b1111_0000
    int b = 0b0000_1111
    a &= 0b1100_1111    ; assert a is 0b1100_0000
    b &= a              ; assert b is 0
}
fn bit_or_assign() {
    int a = 0b1111_0000
    int b = 0b0000_1111
    a |= 1              ; assert a is 0b1111_0001
    b |= a              ; assert b is 0b1111_1111
}
fn shl_assign() {
    int a = 0b1100_1100
    int b = 0b1100
    a <<= 1             ; assert a is 0b000000001_10011000
    b <<= 2             ; assert b is 0b0011_0000
}
fn shr_assign() {
    int a = 0b1100_1100
    int b = 0xff00_0000
    a >>= 1             ; assert a is 0b0110_0110
    b >>= 1             ; assert b is 0xff80_0000
}
fn ushr_assign() {
    int a = 8
    int b = 0xff00_0000
    a >>>= 1            ; assert a is 4
    a >>>= 2            ; assert a is 1
    b >>>= 1            ; assert b is 0x7f80_0000
}

###############################################################################################
# boolean
###############################################################################################
fn less_than() {
    assert 5 < 10
    assert 5 < 5 is false
    assert -1 < 1
}
fn less_than_equal() {
    assert 5 <= 10
    assert 5 <= 5
    assert 5 <= 4 is false
    assert -1 <= -1
}
fn greater_than() {
    assert 10 > 5
    assert 10 > 10 is false
    assert -5 > -10
}
fn greater_than_equal() {
    assert 10 >= 10
    assert 10 >= 9
    assert 10 >= 11 is false
    assert -5 >= -10
    assert -5 >= -5
}
fn unsigned_less_than() {
    assert 1 |<| 5
    assert -1 |<| 5 is false
}
fn unsigned_less_than_equal() {
    assert 1 |<=| 3
    assert 1 |<=| 1
    assert -1 |<=| 1 is false
    assert -1 |<=| -1
}
fn unsigned_greater_than() {
    assert 10 |>| 3
    assert 10 |>| 10 is false
    assert -1 |>| 1             # 0xffffffff > 1
}
fn unsigned_greater_than_equal() {
    assert 10 |>=| 3
    assert 10 |>=| 10
    assert -1 |>=| 1            # 0xffffffff >= 1
    assert -1 |>=| -1
}
fn bool_and() {
    assert true and true
    assert (true and false) is false
    assert (false and true) is false
    assert (false and false) is false
}
fn bool_or() {
    assert true or false
    assert false or true
    assert (false or false) is false
}
