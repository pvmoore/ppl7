{
    "name": "stagecoach-ast-lang",
    "displayName": "Stagecoach-ast",
    "description": "Stagecoach AST syntax highlighting support",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "ast",
                "aliases": [
                    "ast"
                ],
                "extensions": [
                    ".ast"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "ast",
                "scopeName": "source.ast",
                "path": "./syntaxes/ast.tmLanguage.json"
            }
        ]
    },
    "scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@types/node": "^22",
		"@types/vscode": "^1.100.0",
		"typescript": "^5.8.2"
	}
}
