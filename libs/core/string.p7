
public:

struct string {
    byte* ptr
    int len
}

/**
 * Return a slice of the string
 */
fn slice(string str, int start, int end) -> string {
    if(@property(bool, "__BOUNDS_CHECKS__")) {
        // TODO add always assert that is not removed when enableAsserts is false eg.
        // assert_always(start >= 0 && start < str.len)

        // TODO - add preconditions and postconditions for functions
        assert str.ptr is not null
        assert start >= 0 and start < str.len
        assert end >= 0 and end <= start
    }

    // Fixme: this fails to compile. Have we implemented pointer arithmetic?
    //byte* p = str.ptr + start

    string s = { ptr: str.ptr /*+ start*/, len: end - start } // uncomment this when the bug is fixed

    // Fixme - check for return here if the following line is missing
    return s


    // return string {
    //     ptr: str.ptr + start,
    //     len: end - start
    // }
}
